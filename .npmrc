engine-strict=true

# Newly published package versions can be malicious or unstable: only resolve
# versions published at least 7 days ago. This is the event-driven replacement
# for the deleted Dependabot `cooldown: default-days: 7` (#98) — the window
# the removed .github/dependabot.yml claimed this file already had. Internally
# maintained packages update immediately, per `npm help install`'s own example;
# `npm ci` is unaffected (it installs exactly what the lockfile pins).
min-release-age=7
min-release-age-exclude[]=@afixt/*
